{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiliconForge Notification",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "notification_id",
    "project_id",
    "recipient_actor",
    "notification_type",
    "deduplication_key",
    "created_at_utc"
  ],
  "properties": {
    "notification_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "recipient_actor": {
      "type": "string",
      "minLength": 1
    },
    "notification_type": {
      "enum": [
        "APPROVAL_REQUIRED",
        "BLOCKED",
        "VERIFIED",
        "POLICY_DENIED"
      ]
    },
    "deduplication_key": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "read_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "acknowledged_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
